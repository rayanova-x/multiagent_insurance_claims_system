# ----------------------------------------------------
# Smart Claims Processor - Environment Configuration
# Copy this file to .env and fill in your values
# ----------------------------------------------------

# -------- Database -------------------------------------------
# Unset: uses local SQLite files under data/ (no setup needed).
# Set: uses Postgres instead, for users/claims/appeals, the policy DB, the
# HITL queue, and LangGraph's checkpoint store (all in the same instance).
# Render sets this automatically when you attach a Postgres instance to the
# web service - you normally don't need to set it by hand except locally
# against your own Postgres.
#
# If the password contains an @ (or other URL-reserved character), percent-
# encode it (@ -> %40) or the host/password boundary parses wrong.
#
# Supabase specifically: use the "Session pooler" connection string (from
# Project Settings -> Database -> Connect), NOT "Transaction pooler" or
# "Direct connection":
#   - Transaction pooler overrides/ignores session-level settings and will
#     time out (QueryCanceled) on LangGraph's checkpoint-table setup, which
#     runs several CREATE TABLE/ALTER TABLE statements in one go.
#   - Direct connection's hostname (db.xxxx.supabase.co) is IPv6-only on many
#     networks and may fail to resolve at all.
#   - Session pooler (aws-0-xxxx.pooler.supabase.com:5432) works for both
#     normal traffic and the one-time setup.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# Optional: a separate connection string used ONLY for the LangGraph
# checkpointer's one-time setup() call (creates its tables on first boot).
# Needed if DATABASE_URL points at a pooled connection that can't run that
# setup reliably - point this at a connection that can (e.g. your own
# Postgres's normal connection, or Supabase's Session pooler as above). Falls
# back to DATABASE_URL itself when unset, which is fine for a non-pooled
# Postgres (e.g. Render's own managed Postgres).
# DATABASE_URL_DIRECT=postgresql+psycopg://user:password@host:5432/dbname

# -------- Country Profile -------------------------------------------
COUNTRY=india                        # india | us

# -------- LLM Provider -------------------------------------------
# Only need the key for the provider you pick.
LLM_PROVIDER=groq                    # groq | gemini

# Groq - free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Gemini - free key at https://aistudio.google.com/app/apikey
# GOOGLE_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY2=optional_second_key  # separate project = separate daily quota; tried on the same model before the fallback model

# -------- LLM Tuning (optional) -------------------------------------------
# LLM_MODEL=llama-3.1-8b-instant     # change the agent model (defaults are in configs/base.yaml)
# JUDGE_MODEL=gemini-3.5-flash-lite  # change just the LLM-as-judge model (evaluator/judge calls)
# LLM_TEMPERATURE=0.1
# LLM_TIMEOUT_SECONDS=60             # per-request timeout before falling back to llm.fallback_model

# -------- API / Auth -------------------------------------------
API_SECRET_KEY=change-me-to-a-long-random-string   # JWT signing key
# API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -------- HITL (Human-In-The-Loop) Thresholds (optional) -------------------------------------------
# HITL_MIN_AMOUNT=10000          # Claims >= $10K require human review
# HITL_FRAUD_THRESHOLD=0.45      # Fraud score >= 0.45 triggers HITL
# HITL_LOW_CONFIDENCE=0.65       # Agent confidence < 0.65 triggers HITL

# -------- Budget Guards (optional) -------------------------------------------─
# MAX_TOKENS_PER_CLAIM=150000
# MAX_COST_PER_CLAIM=0.50
# MAX_AGENT_CALLS=25

# -------- Security (optional) -------------------------------------------
# AUDIT_LOG_PATH=./data/audit_logs/
# PII_MASKING_ENABLED=true

# -------- Dev/demo only - NEVER set in a real deployment -------------------------------------------
# MOCK_FRAUD_CREW=true   # skips real CrewAI fraud_crew calls for every claim the server processes -
#                          used so the Evals tab's "Run this case" flow doesn't burn real CrewAI quota
#                          on fraud detection, which is out of scope for this rebuild (see
#                          src/agents/fraud_crew.py's run_fraud_crew docstring)

# -------- Tracing / Observability (optional) -------------------------------------------
# LangSmith (smith.langchain.com, free tier) - traces every LLM call this
# app makes (every agent's prompt, response, latency, token usage) with NO
# code changes: LangChain's own callback manager reads these vars directly,
# regardless of how a chat model is constructed (see src/llm.py). This is
# separate from this project's own token/cost tracking in src/llm.py (that
# stays in state for guardrails/audit); LangSmith is for human-readable
# traces you can browse in a dashboard, not a replacement for it.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_api_key_here
# LANGCHAIN_PROJECT=smart-claims-processor
